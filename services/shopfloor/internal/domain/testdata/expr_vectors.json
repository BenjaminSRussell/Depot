{
  "comment": "Shared by the Go evaluator (expr_vectors_test.go) and the kiosk's (apps/web/src/modules/shopfloor/piExpr.test.ts): both must give the same text for every case, or refuse the same expressions.",
  "vars": { "gross": "12.50", "tare": "0.30", "n": "4", "zero": "0", "a": "0.1", "b": "0.2", "x": "1", "t": "90" },
  "cases": [
    { "expr": "gross - tare", "want": "12.2" },
    { "expr": "0.1 + 0.2", "want": "0.3" },
    { "expr": "(gross - tare) / n", "want": "3.05" },
    { "expr": "-gross + 20", "want": "7.5" },
    { "expr": "2 + 3 * 4", "want": "14" },
    { "expr": "(2 + 3) * 4", "want": "20" },
    { "expr": "10 / 4", "want": "2.5" },
    { "expr": "1 / 3", "want": "0.333333333333" },
    { "expr": "2 / 3", "want": "0.666666666667" },
    { "expr": "-2 / 3", "want": "-0.666666666667" },
    { "expr": "abs(tare - gross)", "want": "12.2" },
    { "expr": "min(gross, tare, n)", "want": "0.3" },
    { "expr": "max(gross, n)", "want": "12.5" },
    { "expr": "round(gross / 3, 2)", "want": "4.17" },
    { "expr": "round(1.005, 2)", "want": "1.01" },
    { "expr": "round(-1.005, 2)", "want": "-1.01" },
    { "expr": "round(2.5, 0)", "want": "3" },
    { "expr": "round(-2.5, 0)", "want": "-3" },
    { "expr": "round(0.4999999, 0)", "want": "0" },
    { "expr": "round(1.23456789012345, 12)", "want": "1.234567890123" },
    { "expr": "floor(gross)", "want": "12" },
    { "expr": "floor(-gross)", "want": "-13" },
    { "expr": "ceil(gross)", "want": "13" },
    { "expr": "ceil(-gross)", "want": "-12" },
    { "expr": "a + b == 0.3", "want": "true" },
    { "expr": "1.1 * 1.1 > 1.21", "want": "false" },
    { "expr": "1.1 * 1.1 == 1.21", "want": "true" },
    { "expr": "x / 3 * 3 == x", "want": "false" },
    { "expr": "x / 3 * 3 < x", "want": "true" },
    { "expr": "gross > 10 && n == 4", "want": "true" },
    { "expr": "gross > 10 and n != 4", "want": "false" },
    { "expr": "not (gross < 10) or zero > 1", "want": "true" },
    { "expr": "zero != 0 && 10 / zero > 2", "want": "false" },
    { "expr": "gross <= 12.5 || 1 / zero > 1", "want": "true" },
    { "expr": "gross >= 12.51", "want": "false" },
    { "expr": "!(gross == 12.5)", "want": "false" },
    { "expr": "t > 80 and a + b == 0.3", "want": "true" },
    { "expr": "123456789012345678901234567890 * 10", "want": "1234567890123456789012345678900" },
    { "expr": "0.000000000001 / 10", "want": "0" },
    { "expr": "5. + 1", "want": "6" },
    { "expr": ".5 + 1", "want": "1.5" },
    { "expr": "007 + 1", "want": "8" },
    { "expr": "1 / zero", "want": "error" },
    { "expr": "missing + 1", "want": "error" },
    { "expr": "round(x, 400)", "want": "error" },
    { "expr": "round(x, n + 9)", "want": "error" },
    { "expr": "round(x, 1 / 2)", "want": "error" }
  ],
  "refuse": [
    "", "sqrt(4)", "system(1)", "1; 2", "a = 1", "\"x\"", "a.b", "a[0]", "Gross + 1", "(1 + 2", "1 + 2)", "1 +", "1 + * 2", "1 2",
    "1.2.3", "2x", "(a > 1) + 2", "a and b", "not a", "(a > 1) == (b > 1)", "1 < a < 3", "round(1)", "abs(1, 2)", "min()",
    "abs(a > 1)", "${a}", "`a`", "a | b", "a & b", "round(1, 13)", "round(1, 1.5)", "round(1, -1)", "constructor(1)"
  ]
}
